{
  "name": "chatlk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run sync-assets && node --env-file-if-exists=.env server.js",
    "start": "node --env-file-if-exists=.env server.js",
    "build": "npm run sync-assets",
    "sync-assets": "node scripts/sync-assets.mjs",
    "lint": "node --check server.js src/index.js src/lib/node-env.js",
    "test": "JWT_SECRET=chatlk-local-test-secret-change-me DB_PATH=:memory: node --env-file-if-exists=.env --test --test-concurrency=1 tests/*.test.js",
    "dev:termux": "npm run sync-assets && npx wrangler deploy",
    "deploy": "npm run sync-assets && npx wrangler deploy",
    "deploy:staging": "npm run sync-assets && npx wrangler deploy --env staging",
    "db:migrate": "npx wrangler d1 migrations apply chat-db --remote",
    "db:migrate:staging": "npx wrangler d1 migrations apply chat-db --env staging --remote",
    "secret:set": "npx wrangler secret put JWT_SECRET"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "hono": "^4.6.0",
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "typescript": "^7.0.2",
    "wrangler": "^4.125.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260903.1": true
  }
}
