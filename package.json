{
  "name": "chatlk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run sync-assets && node server.js",
    "start": "node server.js",
    "build": "npm run sync-assets",
    "sync-assets": "node scripts/sync-assets.mjs",
    "lint": "node --check server.js src/index.js src/lib/node-env.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "dev:termux": "npm run sync-assets && npx wrangler deploy --remote"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "hono": "^4.6.0",
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "typescript": "^7.0.2",
    "wrangler": "^4.125.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260903.1": true
  }
}
