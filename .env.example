# ChatLK Application Configuration
# REQUIRED: Set a strong random secret (min 32 chars). Server will not start without this.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
APP_NAME=ChatLK
SUPPORTED_LANGUAGES=si,ta,en
MAX_FILE_SIZE_MB=100
PREMIUM_MAX_FILE_SIZE_MB=500
CORS_ORIGIN=*
DB_PATH=./data/chatlk.db
PORT=3000
