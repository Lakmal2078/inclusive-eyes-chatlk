# Copy to ~/.cloudflared/config.yml and replace the placeholders.
# Create/login to a named tunnel first with:
#   cloudflared tunnel login
#   cloudflared tunnel create fast-cash

tunnel: YOUR_TUNNEL_UUID
credentials-file: /home/ubuntu/.cloudflared/YOUR_TUNNEL_UUID.json

ingress:
  - hostname: your-domain.example.com
    service: http://127.0.0.1:8787
  - service: http_status:404

# For a temporary public URL without a named tunnel, use:
#   cloudflared tunnel --url http://127.0.0.1:8787
